---
import { Image } from 'astro:assets';
import type { CollectionEntry, MarkdownHeading } from 'astro:content';
import { LOCALES, type Locale } from '../consts';
import { formatDate, localePath, readingTime } from '../i18n/utils';
import { ui } from '../i18n/ui';
import BaseLayout from './BaseLayout.astro';
import CodeBlockEnhancer from '../components/CodeBlockEnhancer.astro';
import Comments from '../components/Comments.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getPublishedPosts, getSeriesPosts, postSlug } from '../content-utils';

interface Props {
  post: CollectionEntry<'blog'>;
  locale: Locale;
  slug: string;
  headings?: MarkdownHeading[];
  body?: string;
}

const { post, locale, slug, headings = [], body = '' } = Astro.props;
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
const minutes = body ? readingTime(body, locale) : '';

const tocLabels: Record<Locale, string> = {
  en: 'On this page',
  tr: 'Bu sayfada',
  de: 'Auf dieser Seite',
};
const { title, description, pubDate, updatedDate, heroImage, tags, author } = post.data;
const t = ui[locale];

const allPosts = await getPublishedPosts();
const translations: Partial<Record<Locale, string>> = {};
for (const loc of LOCALES) {
  const sibling = allPosts.find((p) => p.data.lang === loc && postSlug(p) === slug);
  if (sibling) translations[loc] = localePath(loc, `blog/${slug}`);
}

const samelang = allPosts
  .filter((p) => p.data.lang === locale)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const idx = samelang.findIndex((p) => p.id === post.id);
const newer = idx > 0 ? samelang[idx - 1] : null;
const older = idx >= 0 && idx < samelang.length - 1 ? samelang[idx + 1] : null;

const tagSet = new Set(tags.map((t) => t.toLowerCase()));
const related = samelang
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    post: p,
    score: p.data.tags.reduce((acc, t) => acc + (tagSet.has(t.toLowerCase()) ? 1 : 0), 0),
  }))
  .filter((r) => r.score > 0)
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 3);

const labels: Record<Locale, { newer: string; older: string; related: string; partOf: string; series: string }> = {
  en: { newer: 'Newer', older: 'Older', related: 'Related posts', partOf: 'Part', series: 'Series' },
  tr: { newer: 'Sonraki', older: 'Önceki', related: 'İlgili yazılar', partOf: 'Bölüm', series: 'Seri' },
  de: { newer: 'Neuer', older: 'Älter', related: 'Verwandte Beiträge', partOf: 'Teil', series: 'Serie' },
};
const lbl = labels[locale];

const seriesPosts = post.data.series ? await getSeriesPosts(post.data.series.id, locale) : [];
const seriesIndex = post.data.series
  ? seriesPosts.findIndex((p) => p.id === post.id)
  : -1;

const repoUrl = import.meta.env.PUBLIC_REPO_URL as string | undefined;
const editBranch = (import.meta.env.PUBLIC_EDIT_BRANCH as string | undefined) ?? 'main';
const editOnGithub = repoUrl
  ? `${repoUrl.replace(/\/+$/, '')}/edit/${editBranch}/src/content/blog/${post.id}${post.id.endsWith('.mdx') || post.id.endsWith('.md') ? '' : '.md'}`
  : null;

const editLabel: Record<Locale, string> = {
  en: 'Edit this page on GitHub',
  tr: 'Bu sayfayı GitHub’da düzenle',
  de: 'Diese Seite auf GitHub bearbeiten',
};
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  locale={locale}
  pathWithoutLocale={`blog/${slug}`}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  author={author}
  keywords={tags}
  translations={translations}
>
  <div class="pointer-events-none fixed top-0 left-0 z-50 h-0.5 w-full">
    <div id="reading-progress" class="h-full origin-left scale-x-0 bg-brand-500 transition-transform duration-150"></div>
  </div>

  <Breadcrumbs
    locale={locale}
    items={[
      { label: t.blog.title, href: localePath(locale, 'blog') },
      { label: title },
    ]}
  />

  <div class="mx-auto grid max-w-6xl gap-12 px-4 pt-6 pb-16 sm:px-6 xl:grid-cols-[minmax(0,44rem)_14rem]">
  <article
    class="min-w-0 max-w-3xl"
    data-pagefind-body
    data-pagefind-filter={`lang:${locale}`}
    data-pagefind-meta={`lang:${locale},date:${pubDate.toISOString()}`}
  >
    <header class="mb-8">
      <div class="mb-3 flex flex-wrap items-center gap-2 text-xs font-medium text-brand-700 dark:text-brand-300">
        {tags.map((tag) => (
          <span class="rounded-full bg-brand-50 px-2.5 py-1 dark:bg-brand-900/40">#{tag}</span>
        ))}
      </div>
      <h1 class="font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
        {title}
      </h1>
      <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">{description}</p>
      <div class="mt-4 text-sm text-slate-500 dark:text-slate-400">
        <span>{t.blog.publishedOn} <time datetime={pubDate.toISOString()}>{formatDate(pubDate, locale)}</time></span>
        {updatedDate && (
          <>
            <span class="mx-2">·</span>
            <span>
              {t.blog.updatedOn}{' '}
              <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate, locale)}</time>
            </span>
          </>
        )}
        {minutes && (
          <>
            <span class="mx-2">·</span>
            <span>{minutes}</span>
          </>
        )}
      </div>
    </header>

    {heroImage && (
      <div class="mb-10 overflow-hidden rounded-xl border border-slate-200 shadow-sm dark:border-slate-800">
        <Image
          src={heroImage}
          alt={title}
          width={1200}
          height={600}
          class="h-auto w-full no-zoom"
          transition:name={`hero-${post.id}`}
        />
      </div>
    )}

    {tocItems.length > 0 && (
      <details class="mobile-toc xl:hidden" data-mobile-toc>
        <summary>{tocLabels[locale]}</summary>
        <nav aria-label={tocLabels[locale]}>
          <ul>
            {tocItems.map((h) => (
              <li class={h.depth === 3 ? 'depth-3' : ''}>
                <a href={`#${h.slug}`} class="text-slate-700 hover:text-brand-700 dark:text-slate-300 dark:hover:text-brand-300">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    )}

    {post.data.series && seriesPosts.length > 1 && (
      <aside class="mb-10 rounded-lg border border-brand-100 bg-brand-50/50 p-4 dark:border-brand-900/50 dark:bg-brand-900/20">
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-700 dark:text-brand-300">
          {lbl.series}: {post.data.series.title ?? post.data.series.id}
          <span class="ml-2 font-normal text-slate-500 dark:text-slate-400">
            ({lbl.partOf} {(post.data.series.order)}/{seriesPosts.length})
          </span>
        </p>
        <ol class="mt-3 space-y-1.5 text-sm">
          {seriesPosts.map((sp, i) => (
            <li class="flex items-baseline gap-2">
              <span class={`shrink-0 text-xs font-semibold ${i === seriesIndex ? 'text-brand-700 dark:text-brand-300' : 'text-slate-400'}`}>
                {i + 1}.
              </span>
              {sp.id === post.id ? (
                <span class="font-semibold text-slate-900 dark:text-white">{sp.data.title}</span>
              ) : (
                <a
                  href={localePath(locale, `blog/${postSlug(sp)}`)}
                  class="text-slate-700 hover:text-brand-700 dark:text-slate-300 dark:hover:text-brand-300"
                >
                  {sp.data.title}
                </a>
              )}
            </li>
          ))}
        </ol>
      </aside>
    )}

    <div class="prose prose-slate max-w-none dark:prose-invert prose-headings:scroll-mt-24 prose-a:text-brand-600 hover:prose-a:text-brand-700 dark:prose-a:text-brand-400 dark:hover:prose-a:text-brand-300 prose-pre:bg-transparent prose-pre:p-0 prose-pre:border-0 prose-pre:shadow-none">
      <slot />
    </div>

    <CodeBlockEnhancer />

    {(newer || older) && (
      <nav class="mt-16 grid gap-3 sm:grid-cols-2">
        {older ? (
          <a
            href={localePath(locale, `blog/${postSlug(older)}`)}
            class="group flex flex-col rounded-lg border border-slate-200 p-4 transition hover:border-brand-400 hover:bg-brand-50/40 dark:border-slate-800 dark:hover:border-brand-500 dark:hover:bg-brand-900/20"
          >
            <span class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">
              ← {lbl.older}
            </span>
            <span class="mt-1 text-sm font-medium text-slate-900 group-hover:text-brand-700 dark:text-white dark:group-hover:text-brand-300">
              {older.data.title}
            </span>
          </a>
        ) : (
          <span />
        )}
        {newer ? (
          <a
            href={localePath(locale, `blog/${postSlug(newer)}`)}
            class="group flex flex-col rounded-lg border border-slate-200 p-4 text-right transition hover:border-brand-400 hover:bg-brand-50/40 dark:border-slate-800 dark:hover:border-brand-500 dark:hover:bg-brand-900/20"
          >
            <span class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">
              {lbl.newer} →
            </span>
            <span class="mt-1 text-sm font-medium text-slate-900 group-hover:text-brand-700 dark:text-white dark:group-hover:text-brand-300">
              {newer.data.title}
            </span>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )}

    {related.length > 0 && (
      <section class="mt-12">
        <h2 class="mb-4 text-sm font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">
          {lbl.related}
        </h2>
        <ul class="grid gap-4 sm:grid-cols-3">
          {related.map(({ post: rp }) => (
            <li class="rounded-lg border border-slate-200 bg-white p-4 transition hover:shadow-sm dark:border-slate-800 dark:bg-slate-900">
              <a href={localePath(locale, `blog/${postSlug(rp)}`)} class="block">
                <p class="text-xs text-slate-500 dark:text-slate-400">
                  {formatDate(rp.data.pubDate, locale)}
                </p>
                <p class="mt-1 text-sm font-semibold text-slate-900 hover:text-brand-700 dark:text-white dark:hover:text-brand-300">
                  {rp.data.title}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 pt-6 dark:border-slate-800">
      <a
        href={localePath(locale, 'blog')}
        class="inline-flex items-center text-sm font-medium text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300"
      >
        {t.blog.backToList}
      </a>
      {editOnGithub && (
        <a
          href={editOnGithub}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
            <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.8.1-.8.1-.8 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.3 3.6 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0C17.4 4.7 18.4 5 18.4 5c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.3v3.4c0 .3.2.7.9.6A12 12 0 0 0 12 .3Z"/>
          </svg>
          {editLabel[locale]}
        </a>
      )}
    </div>

    <Comments locale={locale} term={`${locale}/${slug}`} />
  </article>

  {tocItems.length > 0 && (
    <aside class="hidden xl:block">
      <nav class="sticky top-24 text-sm" aria-label={tocLabels[locale]}>
        <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
          {tocLabels[locale]}
        </p>
        <ul data-toc class="space-y-1.5 border-l border-slate-200 dark:border-slate-800">
          {tocItems.map((h) => (
            <li class={h.depth === 3 ? 'pl-6' : 'pl-3'}>
              <a
                href={`#${h.slug}`}
                data-toc-link={h.slug}
                class="block border-l-2 border-transparent -ml-px py-0.5 text-slate-600 hover:text-brand-700 dark:text-slate-400 dark:hover:text-brand-300"
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  )}
  </div>

  <script>
    const initReadingUI = () => {
      const bar = document.getElementById('reading-progress');
      const article = document.querySelector('article[data-pagefind-body]') as HTMLElement | null;
      const tocLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'),
      );

      const onScroll = () => {
        if (!bar || !article) return;
        const start = article.offsetTop;
        const end = start + article.offsetHeight - window.innerHeight;
        const y = Math.max(0, window.scrollY - start);
        const ratio = Math.min(1, end > 0 ? y / (end - start) : 0);
        bar.style.transform = `scaleX(${ratio})`;
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);

      const activeClass = ['text-brand-700', 'dark:text-brand-300', 'font-semibold', 'border-brand-500'];
      if (tocLinks.length && article) {
        const headings = Array.from(article.querySelectorAll<HTMLHeadingElement>('h2[id], h3[id]'));
        if (headings.length) {
          const setActive = (id: string) => {
            tocLinks.forEach((a) => {
              const match = a.dataset.tocLink === id;
              activeClass.forEach((c) => a.classList.toggle(c, match));
            });
          };
          const observer = new IntersectionObserver(
            (entries) => {
              const visible = entries
                .filter((e) => e.isIntersecting)
                .sort((a, b) => a.target.getBoundingClientRect().top - b.target.getBoundingClientRect().top);
              if (visible[0]) setActive((visible[0].target as HTMLElement).id);
            },
            { rootMargin: '-80px 0px -70% 0px', threshold: [0, 1] },
          );
          headings.forEach((h) => observer.observe(h));
        }
      }

      // Heading anchor links (hover "#")
      if (article) {
        const anchorLabel =
          (document.documentElement.lang || 'en').startsWith('tr')
            ? 'Bağlantıyı kopyala'
            : (document.documentElement.lang || 'en').startsWith('de')
            ? 'Link kopieren'
            : 'Copy link';
        article.querySelectorAll<HTMLHeadingElement>('h2[id], h3[id], h4[id]').forEach((h) => {
          if (h.querySelector('.heading-anchor')) return;
          const a = document.createElement('a');
          a.href = `#${h.id}`;
          a.className = 'heading-anchor';
          a.setAttribute('aria-label', anchorLabel);
          a.innerHTML = '#';
          h.insertBefore(a, h.firstChild);
        });
      }

      // Image lightbox
      if (article) {
        const imgs = article.querySelectorAll<HTMLImageElement>('img:not(.no-zoom)');
        imgs.forEach((img) => {
          if (img.dataset.zoomBound === '1') return;
          img.dataset.zoomBound = '1';
          img.addEventListener('click', () => {
            const existing = document.querySelector<HTMLDialogElement>('dialog.lightbox');
            existing?.remove();
            const d = document.createElement('dialog');
            d.className = 'lightbox';
            const big = document.createElement('img');
            big.src = img.currentSrc || img.src;
            big.alt = img.alt;
            d.appendChild(big);
            document.body.appendChild(d);
            d.showModal();
            const closeIt = () => { d.close(); d.remove(); };
            d.addEventListener('click', closeIt);
            d.addEventListener('close', () => d.remove());
          });
        });
      }
    };

    initReadingUI();
    document.addEventListener('astro:page-load', initReadingUI);
  </script>
</BaseLayout>
