---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import {
  DEFAULT_LOCALE,
  LOCALES,
  SITE_AUTHOR,
  SITE_KEYWORDS,
  type Locale,
} from '../consts';
import { localeHtmlLang, ui } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  locale: Locale;
  /** Path without a locale prefix, e.g. "blog" or "blog/my-post". */
  pathWithoutLocale?: string;
  keywords?: string[];
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  /** Optional extra RSS feed (e.g. per-tag) to expose. */
  extraFeed?: { title: string; href: string };
}

const {
  title,
  description,
  image = FallbackImage,
  locale,
  pathWithoutLocale = '',
  keywords = SITE_KEYWORDS,
  type = 'website',
  publishedTime,
  modifiedTime,
  author = SITE_AUTHOR,
  extraFeed,
} = Astro.props;

const t = ui[locale];
const siteTitle = t.siteTitle;
const fullTitle = title === siteTitle ? title : `${title} · ${siteTitle}`;

const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN as string | undefined;
const plausibleSrc =
  (import.meta.env.PUBLIC_PLAUSIBLE_SRC as string | undefined) ??
  'https://plausible.io/js/script.js';

const trimmed = pathWithoutLocale.replace(/^\/+/, '').replace(/\/+$/, '');
const buildPath = (loc: Locale) => (trimmed ? `/${loc}/${trimmed}/` : `/${loc}/`);

const canonicalURL = new URL(buildPath(locale), Astro.site);

const ogRoute = (() => {
  const p = pathWithoutLocale.replace(/^\/+/, '').replace(/\/+$/, '');
  if (p.startsWith('blog/') && !p.startsWith('blog/tag/')) {
    const slug = p.slice('blog/'.length);
    return `${import.meta.env.BASE_URL}og/${locale}/${slug}.png`;
  }
  return `${import.meta.env.BASE_URL}og/${locale}/_home.png`;
})();
const ogImage = new URL(ogRoute, Astro.site ?? Astro.url);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'BlogPosting' : 'WebSite',
  name: siteTitle,
  headline: title,
  description,
  inLanguage: localeHtmlLang[locale],
  url: canonicalURL.toString(),
  image: ogImage.toString(),
  author: { '@type': 'Person', name: author },
  publisher: {
    '@type': 'Organization',
    name: siteTitle,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/favicon.svg', Astro.site ?? Astro.url).toString(),
    },
  },
  ...(type === 'article' && publishedTime ? { datePublished: publishedTime.toISOString() } : {}),
  ...(type === 'article' && modifiedTime ? { dateModified: modifiedTime.toISOString() } : {}),
  keywords: keywords.join(', '),
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#4f46e5" />

<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
<link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${siteTitle} (${locale})`}
  href={new URL(`/rss-${locale}.xml`, Astro.site)}
/>
{extraFeed && (
  <link
    rel="alternate"
    type="application/rss+xml"
    title={extraFeed.title}
    href={new URL(extraFeed.href, Astro.site)}
  />
)}

<Font cssVariable="--font-atkinson" preload />
<Font cssVariable="--font-display" />

<link rel="canonical" href={canonicalURL} />

{
  LOCALES.map((loc) => (
    <link
      rel="alternate"
      hreflang={localeHtmlLang[loc]}
      href={new URL(buildPath(loc), Astro.site)}
    />
  ))
}
<link rel="alternate" hreflang="x-default" href={new URL(buildPath(DEFAULT_LOCALE), Astro.site)} />

<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta name="keywords" content={keywords.join(', ')} />
<meta name="robots" content="index, follow" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:locale" content={localeHtmlLang[locale]} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

<script is:inline>
  (function applyTheme() {
    const stored = localStorage.getItem('theme');
    const prefersDark =
      stored === 'dark' ||
      (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.classList.toggle('dark', prefersDark);
  })();
</script>
<script is:inline data-astro-rerun>
  document.addEventListener('astro:after-swap', () => {
    const stored = localStorage.getItem('theme');
    const prefersDark =
      stored === 'dark' ||
      (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.classList.toggle('dark', prefersDark);
  });
</script>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

{plausibleDomain && (
  <script
    is:inline
    defer
    data-domain={plausibleDomain}
    src={plausibleSrc}
  ></script>
)}
