---
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<div class="my-6 overflow-hidden rounded-lg border border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900/50">
  {title && (
    <div class="border-b border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400">
      {title}
    </div>
  )}
  <div class="p-4 font-mono text-sm text-slate-700 dark:text-slate-300 [&_ul]:list-none [&_ul]:ps-5 [&_ul]:border-s [&_ul]:border-slate-300 [&_ul]:dark:border-slate-700 [&_li]:relative [&_li]:ps-3">
    <slot />
  </div>
</div>
