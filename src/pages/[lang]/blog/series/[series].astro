---
import { Image } from 'astro:assets';
import { LOCALES, type Locale } from '../../../../consts';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { formatDate, localePath } from '../../../../i18n/utils';
import { ui } from '../../../../i18n/ui';
import { getPublishedPosts, postSlug } from '../../../../content-utils';

export async function getStaticPaths() {
  const all = await getPublishedPosts();
  const paths: Array<{
    params: { lang: Locale; series: string };
    props: { title: string };
  }> = [];

  for (const lang of LOCALES) {
    const byId = new Map<string, string>();
    for (const p of all) {
      if (p.data.lang !== lang || !p.data.series) continue;
      const id = p.data.series.id;
      if (!byId.has(id)) byId.set(id, p.data.series.title ?? id);
    }
    for (const [id, title] of byId) {
      paths.push({ params: { lang, series: id }, props: { title } });
    }
  }
  return paths;
}

const { lang, series } = Astro.params as { lang: Locale; series: string };
const { title } = Astro.props;
const t = ui[lang];

const all = await getPublishedPosts(lang);
const parts = all
  .filter((p) => p.data.series?.id === series)
  .sort((a, b) => (a.data.series?.order ?? 0) - (b.data.series?.order ?? 0));

const translations: Partial<Record<Locale, string>> = {};
for (const loc of LOCALES) {
  const allLoc = await getPublishedPosts(loc);
  if (allLoc.some((p) => p.data.series?.id === series)) {
    translations[loc] = localePath(loc, `blog/series/${series}`);
  }
}

const labels: Record<Locale, { kicker: string; part: string; allSeries: string }> = {
  en: { kicker: 'Series', part: 'Part', allSeries: '← All posts' },
  tr: { kicker: 'Seri', part: 'Bölüm', allSeries: '← Tüm yazılar' },
  de: { kicker: 'Serie', part: 'Teil', allSeries: '← Alle Beiträge' },
};
const lbl = labels[lang];
---

<BaseLayout
  title={`${title} · ${t.blog.title}`}
  description={`${lbl.kicker}: ${title}`}
  locale={lang}
  pathWithoutLocale={`blog/series/${series}`}
  translations={translations}
>
  <Breadcrumbs
    locale={lang}
    items={[
      { label: t.blog.title, href: localePath(lang, 'blog') },
      { label: title },
    ]}
  />
  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <a
      href={localePath(lang, 'blog')}
      class="inline-flex items-center text-sm text-brand-700 hover:underline dark:text-brand-300"
    >
      {lbl.allSeries}
    </a>
    <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
      {lbl.kicker}
    </p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-slate-900 dark:text-white">{title}</h1>

    <ol class="mt-10 space-y-4">
      {parts.map((p) => (
        <li class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
          <a href={localePath(lang, `blog/${postSlug(p)}`)} class="flex gap-4 sm:gap-6">
            {p.data.heroImage && (
              <Image
                src={p.data.heroImage}
                alt={p.data.title}
                width={240}
                height={140}
                class="hidden h-28 w-44 shrink-0 rounded-lg object-cover sm:block"
              />
            )}
            <div class="min-w-0 flex-1">
              <p class="text-xs font-semibold uppercase tracking-wide text-brand-700 dark:text-brand-300">
                {lbl.part} {p.data.series?.order}
              </p>
              <h2 class="mt-1 text-lg font-semibold text-slate-900 hover:text-brand-700 dark:text-white dark:hover:text-brand-300">
                {p.data.title}
              </h2>
              <p class="mt-1 line-clamp-2 text-sm text-slate-600 dark:text-slate-400">
                {p.data.description}
              </p>
              <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
                {formatDate(p.data.pubDate, lang)}
              </p>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
